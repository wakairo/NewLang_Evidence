diff --git a/tests/p1662/local-let.nl b/tests/p1662/local-let.nl
new file mode 100644
index 0000000000000000000000000000000000000000..190c5ab23a8bd23b28f1e6535400c155fb2d168f
--- /dev/null
+++ b/tests/p1662/local-let.nl
@@ -0,0 +1,17 @@
+fn choose_remainder(flag: bool) -> usize {
+    let stock = usize(83);
+    if (flag) {
+        stock % usize(7)
+    } else {
+        stock % usize(5)
+    }
+}
+
+fn main() -> unit {
+    let limit = usize(100);
+    let early = usize(61) < limit;
+    let late = usize(123) < limit;
+    let first = choose_remainder(early);
+    let second = choose_remainder(late);
+    unit
+}
