diff --git a/tests/p1654/run.py b/tests/p1654/run.py
index a188ad9585569cdac739683c4458d7a911a9ea54..4faec24f2a751366d0c68f10ba4239d4c6ba8894 100644
--- a/tests/p1654/run.py
