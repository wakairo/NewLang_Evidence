diff --git a/tests/p1654/discard.nl b/tests/p1654/discard.nl
new file mode 100644
index 0000000000000000000000000000000000000000..37f6112c59e3f645e39a81c9c4984f2a6c468ed2
--- /dev/null
+++ b/tests/p1654/discard.nl
@@ -0,0 +1,16 @@
+fn select_mark(flag: bool) -> usize {
+    if (flag) {
+        usize(23)
+    } else {
+        usize(41)
+    }
+}
+
+fn main() -> unit {
+    let stock = usize(61);
+    let first_flag = usize(30) < stock;
+    let second_flag = usize(70) < stock;
+    select_mark(first_flag);
+    select_mark(second_flag);
+    unit
+}
