diff --git a/tests/p1654/CMakeLists.txt b/tests/p1654/CMakeLists.txt
new file mode 100644
index 0000000000000000000000000000000000000000..5e49ff56c1f18b95852bab7506a142c534a54806
--- /dev/null
+++ b/tests/p1654/CMakeLists.txt
@@ -0,0 +1,11 @@
+add_executable(p1654_probe tests/p1654/probe.c)
+target_include_directories(p1654_probe PRIVATE src)
+target_link_libraries(p1654_probe PRIVATE newlang_checked_c_node newlang_semantic)
+target_link_options(p1654_probe PRIVATE -Wl,--wrap=malloc
+    -Wl,--wrap=nl_h_custody_seal_result)
+
+set(p1654_source "${CMAKE_CURRENT_SOURCE_DIR}/tests/p1654/selection.nl")
+add_test(NAME p1654_custody_rollback.unit COMMAND p1654_probe "${p1654_source}")
+add_test(NAME p1654_native_scope.unit COMMAND "${Python3_EXECUTABLE}" -B
+    "${CMAKE_CURRENT_SOURCE_DIR}/tests/p1654/run.py"
+    "$<TARGET_FILE:newlangc>" "${CMAKE_CURRENT_BINARY_DIR}/p1654-native" "${p1654_source}")
diff --git a/tests/p1654/probe.c b/tests/p1654/probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..20af2b2fbbfa6c64aaf00fa64a331c336024d3ae
--- /dev/null
+++ b/tests/p1654/probe.c
@@ -0,0 +1,214 @@
+#include "division_usize_internal.h"
+#include "h_origin_internal.h"
+#include "newlang/parser.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define REQUIRE(condition)                                                     \
+    do {                                                                       \
+        if (!(condition)) {                                                    \
+            fprintf(stderr, "p1654:%d: %s\n", __LINE__, #condition);           \
+            return false;                                                      \
+        }                                                                      \
+    } while (0)
+
+typedef enum {
+    NO_FAULT,
+    HELPER_SEAL,
+    ENTRY_WORLD
+} Fault;
+static Fault fault;
+static size_t allocation, visits, hits, failed_bytes;
+
+void *__real_malloc(size_t);
+void *__wrap_malloc(size_t size)
+{
+    if (!allocation || --allocation)
+        return __real_malloc(size);
+    ++hits;
+    failed_bytes = size;
+    return NULL;
+}
+
+NLCheckStatus __real_nl_h_custody_seal_result(NLCheckedFragment *,
+                                              NLCheckedFragment *,
+                                              NLCheckedNodeId,
+                                              const NLSemanticContext *);
+NLCheckStatus __wrap_nl_h_custody_seal_result(NLCheckedFragment *parent,
+                                              NLCheckedFragment *child,
+                                              NLCheckedNodeId id,
+                                              const NLSemanticContext *world)
+{
+    const NLCheckedNodeView *call = nl_checked_node_view(parent, id);
+    const NLCheckedNodeView *actual =
+        call ? nl_checked_node_view(parent, call->first_argument) : NULL;
+    if (fault == HELPER_SEAL && !world && call && call->argument_count == 1 &&
+        actual && actual->kind == NL_CHECKED_IDENTIFIER &&
+        actual->parameter_type ==
+            nl_semantic_core_type(nl_checked_context(parent), NL_TYPE_BOOL)) {
+        ++visits;
+        allocation = 1;
+    } else if (fault == ENTRY_WORLD && world && call && !call->argument_count) {
+        ++visits;
+        /* The entry result stores the node snapshot before the owned world. */
+        allocation = 2;
+    }
+    const NLCheckStatus status =
+        __real_nl_h_custody_seal_result(parent, child, id, world);
+    allocation = 0;
+    return status;
+}
+
+static bool custody(const NLCheckedFragment *entry)
+{
+    REQUIRE(nl_checked_proof_class(entry) == NL_CHECKED_MACHINE_PROVED);
+    NLDivisionUsizePlan main;
+    const NLCheckedNodeId entry_call = nl_checked_root(entry);
+    REQUIRE(nl_quantity_usize_call_valid(entry, entry_call, &main) &&
+            nl_checked_call_body(entry, entry_call) == main.body &&
+            nl_h_custody_result_world_present(entry, entry_call));
+    const NLSemanticContext *world = nl_checked_context(main.body);
+    const NLTypeId boolean = nl_semantic_core_type(world, NL_TYPE_BOOL);
+    const NLCheckedFragment *first = NULL;
+    NLValueId previous_actual = 0, previous_result = 0;
+    size_t seen = 0;
+    for (NLCheckedNodeId id = 1; id <= nl_checked_node_count(main.body); ++id) {
+        const NLCheckedNodeView *call = nl_checked_node_view(main.body, id);
+        if (call->kind != NL_CHECKED_REGISTERED_CALL)
+            continue;
+        NLDivisionUsizePlan plan;
+        REQUIRE(seen < 2 && call->argument_count == 1 &&
+                nl_quantity_usize_call_valid(main.body, id, &plan) &&
+                nl_h_custody_result_valid(main.body, id) &&
+                nl_checked_call_body(main.body, id) == plan.body &&
+                nl_checked_context(plan.body) == world && plan.formal &&
+                !plan.second_formal && !plan.division && first != plan.body);
+        NLCheckedNodeId resolved = 0;
+        REQUIRE(nl_h_custody_body_caller(plan.body, world, &resolved) ==
+                    main.body &&
+                resolved == id);
+        const NLCheckedNodeView *actual =
+            nl_checked_node_view(main.body, call->first_argument);
+        NLSemanticBindingView formal, original;
+        NLSemanticValueView value;
+        REQUIRE(
+            actual && actual->kind == NL_CHECKED_IDENTIFIER &&
+            actual->value_use == NL_VALUE_COPIED && actual->result_count == 1 &&
+            actual->parameter_type == boolean && !actual->next_argument &&
+            nl_semantic_binding_view(world, actual->symbol, &original) &&
+            nl_semantic_binding_view(world, plan.formal, &formal) &&
+            formal.type == boolean &&
+            formal.value == actual->results[0].value &&
+            formal.value > previous_actual && formal.value != original.value &&
+            formal.place != original.place &&
+            nl_semantic_value_view(world, formal.value, &value) &&
+            value.scalar_known && value.scalar_value == (seen == 0));
+        const NLCheckedNodeView *body =
+            nl_checked_node_view(plan.body, nl_checked_root(plan.body));
+        REQUIRE(body && body->result_count == 1 && call->result_count == 1 &&
+                body->results[0].value == call->results[0].value &&
+                call->results[0].value > previous_result);
+        first = plan.body;
+        previous_actual = formal.value;
+        previous_result = call->results[0].value;
+        ++seen;
+    }
+    REQUIRE(seen == 2);
+    puts("CUSTODY two ordered actual Copy slots, distinct fresh formals and "
+         "BODY/results");
+    return true;
+}
+
+static bool rollback(NLSemanticContext *c, const NLSyntaxTree *expression,
+                     NLCheckedFragment **entry)
+{
+    NLSymbolId symbol = 0;
+    const NLScalarValue seed = {nl_semantic_core_type(c, NL_TYPE_USIZE), true,
+                                1654};
+    REQUIRE(nl_semantic_seed_scalar(c, "p1654_anchor", seed, &symbol) ==
+                NL_CHECK_OK &&
+            symbol);
+    const NLSemanticBindingView b = c->bindings[symbol - 1].view;
+    unsigned char context[sizeof(*c)], binding[sizeof(*c->bindings)],
+        place[sizeof(*c->places)], value[sizeof(*c->values)];
+    memcpy(context, c, sizeof(context));
+    memcpy(binding, &c->bindings[symbol - 1], sizeof(binding));
+    memcpy(place, &c->places[b.place - 1], sizeof(place));
+    memcpy(value, &c->values[b.value - 1], sizeof(value));
+    for (Fault site = HELPER_SEAL; site <= ENTRY_WORLD; ++site) {
+        fault = site;
+        visits = hits = failed_bytes = 0;
+        const NLCheckStatus status =
+            nl_semantic_check_expression(c, expression, entry, NULL);
+        fault = NO_FAULT;
+        REQUIRE(status == NL_CHECK_OUT_OF_MEMORY && !*entry && visits == 1 &&
+                hits == 1 && failed_bytes &&
+                !memcmp(context, c, sizeof(context)) &&
+                !memcmp(binding, &c->bindings[symbol - 1], sizeof(binding)) &&
+                !memcmp(place, &c->places[b.place - 1], sizeof(place)) &&
+                !memcmp(value, &c->values[b.value - 1], sizeof(value)) &&
+                nl_sem_validate(c) == NL_CHECK_OK);
+        printf("OOM %s reached=%zu hit=%zu bytes=%zu rollback=PASS\n",
+               site == HELPER_SEAL ? "bool-helper-seal" : "entry-result-world",
+               visits, hits, failed_bytes);
+    }
+    REQUIRE(nl_semantic_check_expression(c, expression, entry, NULL) ==
+                NL_CHECK_OK &&
+            *entry && custody(*entry));
+    char *text = NULL;
+    size_t length = 1654;
+    hits = failed_bytes = 0;
+    allocation = 1;
+    const NLCheckStatus status = nl_quantity_usize_c17(*entry, &text, &length);
+    allocation = 0;
+    const bool preserved = !text && length == 1654 && hits == 1 && failed_bytes;
+    free(text);
+    REQUIRE(status == NL_CHECK_OUT_OF_MEMORY && preserved);
+    printf("OOM C17 staging hit=%zu bytes=%zu output-preserved=PASS\n", hits,
+           failed_bytes);
+    const bool emitted =
+        nl_quantity_usize_c17(*entry, &text, &length) == NL_CHECK_OK && text &&
+        length && strstr(text, "(_Bool nl_local_") &&
+        strstr(text, "UINTMAX_C(19)");
+    free(text);
+    REQUIRE(emitted);
+    puts("CHECK/C17 retry PASS");
+    return true;
+}
+
+int main(int argc, char **argv)
+{
+    if (argc != 2)
+        return 2;
+    NLSource *source = NULL, *entry_source = NULL;
+    NLParser *parser = NULL, *entry_parser = NULL;
+    NLSyntaxTree *unit = NULL, *expression = NULL;
+    NLSemanticContext *context = NULL;
+    NLCheckedFragment *entry = NULL;
+    bool ready =
+        nl_source_load(argv[1], &source) == NL_SOURCE_OK &&
+        nl_parser_create(source, &parser) == NL_PARSE_OK &&
+        nl_parser_parse_function_unit(parser, &unit, NULL) == NL_PARSE_OK &&
+        nl_semantic_create(&context) == NL_CHECK_OK;
+    const NLSyntaxTree *units[] = {unit};
+    ready = ready &&
+            nl_semantic_register_function_unit(context, units, 1, NULL) ==
+                NL_CHECK_OK &&
+            nl_source_create("main()", sizeof("main()") - 1, "<p1654-entry>",
+                             &entry_source) == NL_SOURCE_OK &&
+            nl_parser_create(entry_source, &entry_parser) == NL_PARSE_OK &&
+            nl_parser_parse_expression_fragment(entry_parser, &expression,
+                                                NULL) == NL_PARSE_OK;
+    const bool ok = ready && rollback(context, expression, &entry);
+    nl_checked_destroy(entry);
+    nl_syntax_tree_destroy(expression);
+    nl_parser_destroy(entry_parser);
+    nl_source_destroy(entry_source);
+    nl_semantic_destroy(context);
+    nl_syntax_tree_destroy(unit);
+    nl_parser_destroy(parser);
+    nl_source_destroy(source);
+    return ok ? 0 : 1;
+}
diff --git a/tests/p1654/run.py b/tests/p1654/run.py
new file mode 100644
index 0000000000000000000000000000000000000000..91aa340881e60f72802e4efab519f715977375f5
--- /dev/null
+++ b/tests/p1654/run.py
@@ -0,0 +1,130 @@
+"""Check the unary Bool quantity selector and its strict native output."""
+
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+
+
+def run(raw, name, command, expected):
+    args = list(map(str, command))
+    result = subprocess.run(args, capture_output=True, check=False)
+    (raw / f"{name}.command").write_text("\n".join(args) + "\n", encoding="utf-8")
+    (raw / f"{name}.status").write_text(f"{result.returncode}\n", encoding="ascii")
+    (raw / f"{name}.stdout").write_bytes(result.stdout)
+    (raw / f"{name}.stderr").write_bytes(result.stderr)
+    assert result.returncode == expected, (name, result.returncode, result.stderr)
+    return result
+
+
+def observe(c):
+    helper = re.search(rb"static size_t (nl_qty_fn_\d+)\(_Bool (nl_local_\d+)\)", c)
+    entry = re.search(rb"^static void nl_qty_fn_\d+\(void\)\n\{\n", c, re.MULTILINE)
+    assert helper and entry and helper.end() < entry.start()
+    assert re.search(rb"_Bool nl_condition_\d+ = " + helper[2] + rb";", c)
+    prefix, main = c[:entry.end()], c[entry.end():]
+    assert main.count(helper[1] + b"(") == 2
+    calls = re.findall(
+        rb"^    size_t (nl_local_\d+) = " + helper[1] + rb"\((nl_local_\d+)\);$",
+        main, re.MULTILINE,
+    )
+    flags = re.findall(rb"^    _Bool (nl_local_\d+) = ", main, re.MULTILINE)
+    assert len(calls) == len(flags) == 2
+    assert [arg for _, arg in calls] == flags
+    marker = b"#include <stdint.h>\n"
+    assert prefix.count(marker) == 1
+    observed, count = re.subn(
+        rb"^(    size_t (nl_local_\d+) = " + helper[1] + rb"\(nl_local_\d+\);)\n",
+        rb'\1\n    printf("%zu\\n", \2);\n', main, flags=re.MULTILINE,
+    )
+    assert count == 2
+    return prefix.replace(marker, marker + b"#include <stdio.h>\n") + observed
+
+
+def native(cli, source, raw):
+    c = run(raw, "stdout-c17", [cli, source], 0)
+    assert c.stdout and not c.stderr
+    pristine = raw / "pristine.c"
+    named = run(raw, "named-c17", [cli, "--emit-c17-to", pristine, source], 0)
+    assert not named.stdout and not named.stderr and pristine.read_bytes() == c.stdout
+    observed = raw / "observed.c"
+    observed.write_bytes(observe(c.stdout))
+    compilers = (shutil.which("gcc"), shutil.which("clang-23") or shutil.which("clang"))
+    assert all(compilers), compilers
+    for compiler in compilers:
+        for opt in ("O0", "O2"):
+            for unit, stdout in ((pristine, b""), (observed, b"11\n19\n")):
+                label = f"{Path(compiler).name}-{opt}-{unit.stem}"
+                binary = raw / label
+                run(raw, label + "-compile", [
+                    compiler, "-std=c17", "-pedantic-errors", "-Wall", "-Wextra",
+                    "-Werror", "-" + opt, unit, "-o", binary,
+                ], 0)
+                result = run(raw, label + "-native", [binary], 0)
+                assert result.stdout == stdout and not result.stderr, label
+    print(f"{raw.name} strict native 11 then 19; named C17 identical")
+
+
+def state(path):
+    stat = path.stat()
+    return (stat.st_dev, stat.st_ino, stat.st_mode, stat.st_size,
+            stat.st_mtime_ns, stat.st_ctime_ns)
+
+
+def scope(cli, source, raw):
+    diagnostic = b"error(cli)[V1-BACKEND-UNSUPPORTED]:"
+    emitted = run(raw, "stdout-c17", [cli, source], 4)
+    assert not emitted.stdout and emitted.stderr.startswith(diagnostic)
+    named_dir = raw / "named"
+    named_dir.mkdir()
+    target = named_dir / "existing.c"
+    sentinel = b"/* Preserved existing C17 output. */\nint original;\n"
+    target.write_bytes(sentinel)
+    before = state(target)
+    named = run(raw, "named-c17", [cli, "--emit-c17-to", target, source], 4)
+    assert not named.stdout and named.stderr.startswith(diagnostic)
+    after = state(target)
+    (raw / "named-stat.txt").write_text(f"{before}\n{after}\n", encoding="ascii")
+    assert target.read_bytes() == sentinel and before == after
+    assert list(named_dir.iterdir()) == [target]
+    print(f"{raw.name} CHECK=0 C17=4, named output preserved")
+
+
+def fixtures(selection):
+    before, original = selection.split("\n\n", 1)
+    body = before.replace("let amount = if", "if").replace("};\n    amount", "}")
+    yield "let-copy", selection, native
+    yield "direct-tail", f"{body}\n\n{original}", native
+    yield "inline-actual", selection.replace(
+        "choose(select_first)", "choose(usize(50) < stock)"
+    ), scope
+    yield "local-numerator", selection.replace(
+        "        usize(11)", "        let numerator = usize(77);\n        numerator / usize(7)"
+    ), scope
+    yield "called-from-helper", selection.replace(
+        "fn main()", "fn relay(flag: bool) -> usize { choose(flag) }\n\nfn main()"
+    ).replace("choose(select_first)", "relay(select_first)"), scope
+
+
+def main():
+    cli, root, selection = map(Path, sys.argv[1:])
+    root.mkdir(parents=True, exist_ok=True)
+    raw = Path(tempfile.mkdtemp(dir=root))
+    print(f"raw={raw}", flush=True)
+    cases = []
+    for name, text, verify in fixtures(selection.read_text(encoding="utf-8")):
+        work = raw / name
+        work.mkdir()
+        source = work / "source.nl"
+        source.write_text(text, encoding="utf-8")
+        cases.append((source, work, verify))
+    for source, work, verify in cases:
+        check = run(work, "check", [cli, "--check", source], 0)
+        assert not check.stdout and not check.stderr
+        verify(cli, source, work)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/p1654/selection.nl b/tests/p1654/selection.nl
new file mode 100644
index 0000000000000000000000000000000000000000..713cc5acd51e3b53a8d4c003c9a7bc5017061ab0
--- /dev/null
+++ b/tests/p1654/selection.nl
@@ -0,0 +1,17 @@
+fn choose(flag: bool) -> usize {
+    let amount = if (flag) {
+        usize(11)
+    } else {
+        usize(19)
+    };
+    amount
+}
+
+fn main() -> unit {
+    let stock = usize(77);
+    let select_first = usize(50) < stock;
+    let select_second = usize(90) < stock;
+    let first = choose(select_first);
+    let second = choose(select_second);
+    unit
+}
