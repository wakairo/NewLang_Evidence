-            composed_quantity_body(
-                f, c,
-                nl_quantity_usize_function(c, function,
-                                           c->functions[function - 1].count),
-                function, depth, remaining, out));
+    if (division_helper(f, c, function, operation, out))
+        return true;
+    if (operation != NL_USIZE_ANY_FIXED_DIVISOR)
