new file mode 100644
index 0000000000000000000000000000000000000000..b0bf830a94f910b3f8217e9600dc9c56a594eb35
--- /dev/null
+++ b/tests/p1529/consumer.c
@@ -0,0 +1,81 @@
+/* Reuse P's source loader and host wrappers; no new proof or fault engine. */
+#define main retained_p1463_main
+#include "../p1463/probe.c"
+#undef main
+
+static NLCheckedNodeView *prefix_read, *terminal;
+static void locate(NLCheckedFragment *f)
+{
+    for (size_t i = 1; i <= f->count; ++i) {
+        NLCheckedNodeView *n = &f->nodes[i - 1];
+        if (!prefix_read && n->kind == NL_CHECKED_FIELD_READ)
+            prefix_read = n;
+        if (n->owner_call.entry_proved)
+            terminal = n;
+        NLCheckedFragment *body =
+            (NLCheckedFragment *)nl_checked_call_body(f, i);
+        if (body)
+            locate(body);
+        if (n->kind == NL_CHECKED_MATCH)
+            for (size_t a = 0; a < n->item_count; ++a)
+                locate((NLCheckedFragment *)nl_checked_match_arm(f, i, a));
+    }
+}
+static bool agreement(const char *path, const char *raw)
+{
+    Program p = {0};
+    CHECK(ready(path, &p) && actual(&p));
+    char *text = NULL;
+    size_t length = 0;
+    CHECK(nl_checked_c_node(p.artifact, &text, &length) == NL_NODE_C_OK);
+    NLSource *expected = NULL;
+    CHECK(nl_source_load(raw, &expected) == NL_SOURCE_OK);
+    NLSourceView v;
+    CHECK(nl_source_view(expected,
+                         (NLSourceSpan){0, nl_source_length(expected)}, &v));
+    CHECK(v.length == length && !memcmp(v.bytes, text, length));
+    printf("P1529 genuine public API / CLI bytes agree: %zu\n", length);
+    nl_source_destroy(expected);
+    free(text);
+    destroy(&p);
+    return true;
+}
+static bool attacks(const char *path)
+{
+    Program p = {0}, foreign = {0};
+    CHECK(ready(path, &p) && actual(&p) && ready(path, &foreign) &&
+          actual(&foreign));
+    locate(p.artifact);
+    CHECK(prefix_read && terminal);
+    NLCheckedNodeView saved = *prefix_read;
+    prefix_read->field.child_fact = 0;
+    bool bad = refused(&p, "prefix current fact");
+    *prefix_read = saved;
+    CHECK(bad && emit(&p, NL_NODE_C_OK));
+    prefix_read->results[0].value = 0;
+    bad = refused(&p, "prefix Copy result");
+    *prefix_read = saved;
+    CHECK(bad && emit(&p, NL_NODE_C_OK));
+    struct NLHOriginOwner *origin = p.artifact->h_origin;
+    p.artifact->h_origin = foreign.artifact->h_origin;
+    bad = refused(&p, "foreign authentic origin world");
+    p.artifact->h_origin = origin;
+    CHECK(bad && emit(&p, NL_NODE_C_OK));
+    saved = *terminal;
+    terminal->owner_call.domain = 0;
+    bad = refused(&p, "terminal original Domain");
+    *terminal = saved;
+    CHECK(bad && emit(&p, NL_NODE_C_OK));
+    printf("P1529 four isolated artifact negatives / pristine retries PASS\n");
+    destroy(&foreign);
+    destroy(&p);
+    return true;
+}
+int main(int argc, char **argv)
+{
+    if (argc == 4 && !strcmp(argv[1], "agree"))
+        return agreement(argv[2], argv[3]) ? 0 : 1;
+    if (argc == 3 && !strcmp(argv[1], "attack"))
+        return attacks(argv[2]) ? 0 : 1;
+    return 2;
+}
diff --git a/tests/p1529/native.py b/tests/p1529/native.py
new file mode 100644
index 0000000000000000000000000000000000000000..ec43a3c59cc1d15b1d61b0241894e556ad647385
--- /dev/null
+++ b/tests/p1529/native.py
@@ -0,0 +1,62 @@
+"""Finite prefix-read/old-Copy regression; physical H0/H1/H2, strict C17."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+CASES = [("A-prefix-zero", 0, 1), ("B-prefix-nonzero", 37, 1),
+         ("C-oldcopy-zero", 0, 0), ("D-combined-nonzero", 37, 1)]
+
+
+def compile_and_run(cc, tests, raw, out, case, opt, sanitizer, run):
+    name, sample, reads = case
+    exe = out / (name + "-O" + str(opt))
+    strict = ["-std=c17", "-Wall", "-Wextra", "-Wpedantic", "-Werror"]
+    flags = [] if sanitizer == "none" else ["-fsanitize=" + sanitizer,
+        "-fno-omit-frame-pointer", "-fno-sanitize-recover=all"]
+    before = hashlib.sha256(raw.read_bytes()).hexdigest()
+    run(exe.name + "-cc", [cc, *strict, "-O" + str(opt), *flags,
+        "-DP1517_SAMPLE=" + str(sample), "-DP1529_PREFIX_READS=" + str(reads),
+        '-DNEWLANG_NODE_OBSERVER="' + str(tests / "passive.h") + '"',
+        '-DNEWLANG_HEAP_OBSERVER="' + str(tests / "passive.h") + '"',
+        raw, tests / "../p1517/guest_wrap.c", "-Wl,--wrap=malloc",
+        "-Wl,--wrap=free", "-o", exe], units=2)
+    for fail in [1, 2, 0]:
+        result = run(exe.name + "-H" + str(fail), [exe], guest=True,
+                     setting={"P1517_FAIL_AT": str(fail)})
+        assert b"receiver-exact PASS" in result.stdout
+    assert hashlib.sha256(raw.read_bytes()).hexdigest() == before
+
+
+def main():
+    compiler, cc, tests_arg, output, sanitizer = sys.argv[1:]
+    tests, out = Path(tests_arg).resolve(), Path(output).resolve()
+    out.mkdir(parents=True, exist_ok=True)
+    rows = []
+
+    def run(label, argv, units=1, guest=False, setting=None):
+        env = dict(os.environ, ASAN_OPTIONS="detect_leaks=1:halt_on_error=1",
+                   UBSAN_OPTIONS="halt_on_error=1:print_stacktrace=1")
+        env.update(setting or {})
+        argv = list(map(str, argv))
+        r = subprocess.run(argv, capture_output=True, env=env)
+        for suffix, data in [("stdout", r.stdout), ("stderr", r.stderr)]:
+            (out / (label + "." + suffix)).write_bytes(data)
+        rows.append(dict(label=label, argv=argv, translation_units=units,
+                         guest=guest, exit=r.returncode))
+        (out / "ledger.json").write_text(json.dumps(rows, indent=2) + "\n")
+        assert r.returncode == 0, (label, r.stderr)
+        return r
+
+    for case in CASES:
+        raw = out / (case[0] + ".c")
+        run("emit-" + case[0], [compiler, "--emit-c17-to", raw,
+                                tests / (case[0] + ".nl")])
+        compile_and_run(cc, tests, raw, out, case, 2, sanitizer, run)
+    print("P1529 four finite compositions x H0/H1/H2 PASS")
+
+
+if __name__ == "__main__":
+    main()
