From a026544d52ce631e339dbd5ec40c6fc3ebcca734 Mon Sep 17 00:00:00 2001
From: J W <a_kg@ninegw.sakura.ne.jp>
Date: Thu, 19 Nov 2026 16:05:02 +0900
Subject: [PATCH] Connect direct H scalar helper to existing readonly consumer

---
 src/checked_c_node.c                    |  5 +++--
 src/checked_c_scalar_control_internal.h | 21 +++++++++++++++++++--
 2 files changed, 22 insertions(+), 4 deletions(-)

diff --git a/src/checked_c_node.c b/src/checked_c_node.c
index e18c444ffc667be9022819c9b6151cf10b82d34b..1d17ce025905b18b0b92dbae81ffb8f3d27f947f 100644
--- a/src/checked_c_node.c
+++ b/src/checked_c_node.c
@@ -1231,8 +1231,9 @@ static bool expr(Emit *e, Env *env, NLCheckedNodeId id, Value *out)
         return put(e, "uint8_t nl_v_%zu=nl_b_%zu_%zu.f%zu;\n", out->temp,
                    l->frame, l->symbol, v->field.index);
     }
-    if (v->kind == NL_CHECKED_REGISTERED_CALL && e->scalar_control &&
-        e->copy_type && v->type == e->u8)
+    if (v->kind == NL_CHECKED_REGISTERED_CALL && e->copy_type &&
+        v->type == e->u8 &&
+        (e->scalar_control || direct_scalar_call(e, env, v)))
         return scalar_readonly_call(e, env, id, v, out);
     if (v->kind == NL_CHECKED_REGISTERED_CALL)
         return e->qualified_unchecked && env->artifact == e->qualified_owner &&
diff --git a/src/checked_c_scalar_control_internal.h b/src/checked_c_scalar_control_internal.h
index 177f275f9de695201929519239af8671a620a447..10fe0ac4d98a55f261a34c9ad1508a7f5d2e4b8b 100644
--- a/src/checked_c_scalar_control_internal.h
+++ b/src/checked_c_scalar_control_internal.h
@@ -124,11 +124,28 @@ static bool scalar_selection_call(Emit *e, Env *env, NLCheckedNodeId id,
  * Copy-local chains. Inline that chain using the once-evaluated runtime
  * actual, never a Known summary. T admission still needs its separate actual
  * stateful entry; no H authority enters this callee or escapes an IF arm. */
+static bool direct_scalar_call(const Emit *e, const Env *env,
+                               const NLCheckedNodeView *call)
+{
+    const NLCheckedNodeView *receiver = nl_checked_node_view(
+        e->direct_receiver_issuer, e->direct_receiver_call);
+    return e->direct_h && e->two_heap && e->copy_type && !e->live_tail &&
+           !e->custody && !e->current && !e->producer_calls &&
+           !e->owner_calls && e->direct_payload_reads == 1 &&
+           e->lifecycle[0].stage == 4 && e->lifecycle[1].stage == 4 &&
+           !env->stability_scope &&
+           env->artifact == e->direct_receiver_issuer && receiver &&
+           call->argument_count == 1 &&
+           call->span.end_byte < receiver->span.start_byte;
+}
+
 static bool scalar_readonly_call(Emit *e, Env *env, NLCheckedNodeId id,
                                  const NLCheckedNodeView *call, Value *out)
 {
-    if (!e->scalar_issued || !e->scalar_control || !e->copy_type ||
-        env->scalar_read_arm || ++e->scalar_readonly_calls != 1)
+    if (!e->scalar_issued ||
+        (!e->scalar_control && !direct_scalar_call(e, env, call)) ||
+        !e->copy_type || env->scalar_read_arm ||
+        ++e->scalar_readonly_calls != 1)
         return reject(e);
     if (call->argument_count == 2)
         return scalar_selection_call(e, env, id, call, out);
-- 
